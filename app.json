{
  "expo": {
    "name": "Stridr",
    "slug": "stridr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stridr",
    "userInterfaceStyle": "automatic",
    "owner": "matias.turra",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.matiasturra.stridr",
      "appleTeamId": "7VJ997Q842",
      "buildNumber": "1",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.matiasturra.stridr"]
      },
      "infoPlist": {
        "CFBundleLocalizations": ["en", "es"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.matiasturra.stridr",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#fcba03"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#121212"
          }
        }
      ],
      "expo-sqlite",
      "expo-localization",
      "expo-font",
      "expo-web-browser",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713"
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "Items",
              "displayName": "Stridr",
              "description": "Latest items at a glance",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"]
              }
            }
          ]
        }
      ],
      "./plugins/with-scene-lifecycle",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
