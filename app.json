{
  "expo": {
    "name": "Stridr",
    "slug": "stridr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stridr",
    "userInterfaceStyle": "automatic",
    "owner": "matias.turra",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.matiasturra.stridr",
      "appleTeamId": "7VJ997Q842",
      "buildNumber": "1",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.matiasturra.stridr"
        ]
      },
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "es"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "package": "com.matiasturra.stridr",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      "expo-localization",
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "Steps",
              "displayName": "Stridr",
              "description": "Today's steps and goal progress",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            },
            {
              "name": "StepsRing",
              "displayName": "Stridr Ring",
              "description": "Today's steps as a goal ring",
              "ios": {
                "supportedFamilies": [
                  "systemSmall"
                ]
              }
            },
            {
              "name": "StepsBar",
              "displayName": "Stridr Bar",
              "description": "Today's steps as a walk along your goal",
              "ios": {
                "supportedFamilies": [
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-sharing",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Stridr reads your step count from Apple Health to show your daily total, history and goal progress. Nothing leaves your device.",
          "NSHealthUpdateUsageDescription": false,
          "background": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.matiasturra.stridr.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.matiasturra.stridr"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "a0c40262-fc7e-4720-882a-c7b22b742b73"
      }
    }
  }
}
